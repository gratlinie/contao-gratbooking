{
    "name": "gratlinie/contao-gratbooking",
    "description": "GratBooking – Termine aus dem Google Kalender buchen, mit automatisch erzeugtem Zoom-Meeting: Bestätigung mit Kalenderdatei, Erinnerung, Absagen und Umbuchen per Link",
    "keywords": [
        "contao",
        "google-calendar",
        "zoom",
        "zoom-meeting",
        "termine",
        "terminbuchung",
        "booking",
        "appointment-booking",
        "scheduling",
        "video-call",
        "coaching",
        "gratframe"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "homepage": "https://github.com/gratlinie/contao-gratbooking",
    "authors": [
        {
            "name": "Gratlinie",
            "email": "mail@gratlinie.de"
        }
    ],
    "support": {
        "issues": "https://github.com/gratlinie/contao-gratbooking/issues",
        "source": "https://github.com/gratlinie/contao-gratbooking"
    },
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "contao/core-bundle": "^5.7",
        "symfony/http-client": "^7.0",
        "terminal42/notification_center": "^2.7"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0",
        "gratlinie/contao-gratshop": "<0.5.2"
    },
    "autoload": {
        "psr-4": {
            "Gratlinie\\GratBookingBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Gratlinie\\GratBookingBundle\\ContaoManager\\Plugin"
    }
}
