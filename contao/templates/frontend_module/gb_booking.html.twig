{% extends '@Contao/frontend_module/_base.html.twig' %}
{% import '@Contao/component/_gb_picker.html.twig' as gb %}

{% block content %}
    {% add 'gratbooking_css' to head %}<link rel="stylesheet" href="{{ asset('css/gratbooking.css', 'gratlinie_grat_booking') }}">{% endadd %}
    {% add 'gratbooking_js' to body %}<script src="{{ asset('js/gratbooking.js', 'gratlinie_grat_booking') }}" defer></script>{% endadd %}
    <div class="gb" id="{{ anchor }}">
        {% if step == 'done' %}
            <div class="gb-done" role="status">
                <h2 class="gb-done__title">{{ 'MSC.gb_done_title'|trans([], 'contao_default') }}</h2>
                <p class="gb-done__when"><strong>{{ booking_type.title }}</strong><br>{{ when.date }}, {{ when.time }}</p>
                {% if amount %}<p class="gb-done__paid">{{ 'MSC.gb_paid'|trans([amount], 'contao_default') }}</p>{% endif %}
                <p>{{ 'MSC.gb_done_text'|trans([booking.email], 'contao_default') }}</p>
                {% if booking.zoomJoinUrl %}<p><a class="gb-link" href="{{ booking.zoomJoinUrl }}" target="_blank" rel="noopener">{{ 'MSC.gb_zoom_link'|trans([], 'contao_default') }}</a></p>{% endif %}
            </div>
        {% elseif step == 'waiting' %}
            <div class="gb-done" role="status">
                <h2 class="gb-done__title">{{ 'MSC.gb_waiting_title'|trans([], 'contao_default') }}</h2>
                <p class="gb-done__when"><strong>{{ booking_type.title }}</strong><br>{{ when.date }}, {{ when.time }}</p>
                <p>{{ 'MSC.gb_waiting_text'|trans([booking.email], 'contao_default') }}</p>
                <p><a class="gb-link" href="{{ reload_url }}">{{ 'MSC.gb_waiting_reload'|trans([], 'contao_default') }}</a></p>
            </div>
        {% elseif step == 'unavailable' %}
            <p class="gb-empty">{{ 'MSC.gb_unavailable'|trans([], 'contao_default') }}</p>
        {% elseif step == 'types' %}
            <ul class="gb-types" role="list">
                {% for t in gb_types %}
                    <li class="gb-type">
                        <a class="gb-type__link" href="{{ t.url }}" rel="nofollow">
                            <span class="gb-type__title">{{ t.title }}</span>
                            <span class="gb-type__meta gb-meta"><span>{{ 'MSC.gb_minutes'|trans([t.duration], 'contao_default') }}</span>{% if t.zoom %}<span class="gb-sep" aria-hidden="true"></span><span>Zoom</span>{% endif %}</span>
                            {% if t.description %}<span class="gb-type__text">{{ t.description|nl2br }}</span>{% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="gb-head">
                <p class="gb-head__type gb-meta"><strong>{{ gb_type.title }}</strong><span class="gb-sep" aria-hidden="true"></span><span>{{ 'MSC.gb_minutes'|trans([gb_type.duration], 'contao_default') }}</span>{% if gb_type.zoom %}<span class="gb-sep" aria-hidden="true"></span><span>Zoom</span>{% endif %}{% if price %}<span class="gb-sep" aria-hidden="true"></span><span>{{ 'MSC.gb_price'|trans([price], 'contao_default') }}</span>{% endif %}</p>
                {% if change_url %}<a class="gb-link" href="{{ change_url }}" rel="nofollow">{{ 'MSC.gb_change_type'|trans([], 'contao_default') }}</a>{% endif %}
            </div>
            {% if notice == 'aborted' %}<p class="gb-notice" role="status">{{ 'MSC.gb_aborted_notice'|trans([], 'contao_default') }}</p>{% endif %}
            {% if errors.zeit|default %}<p class="gb-error" role="alert">{{ errors.zeit }}</p>{% endif %}
            {{ gb.picker(picker) }}
            {% if picker.selected %}
                <form class="gb-form" method="post" action="#{{ anchor }}" novalidate>
                    <input type="hidden" name="FORM_SUBMIT" value="{{ form_id }}">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
                    <input type="hidden" name="zeit" value="{{ picker.selected }}">
                    <h3 class="gb-form__title">{{ picker.selected_label.date }}, {{ picker.selected_label.time }}</h3>
                    {% if errors.form|default %}<p class="gb-error" role="alert">{{ errors.form }}</p>{% endif %}
                    <div class="gb-form__grid">
                        {{ gb.field('firstname', 'MSC.gb_firstname'|trans([], 'contao_default'), values, errors, 'text', true, 'autocomplete="given-name"') }}
                        {{ gb.field('lastname', 'MSC.gb_lastname'|trans([], 'contao_default'), values, errors, 'text', true, 'autocomplete="family-name"') }}
                        {{ gb.field('email', 'MSC.gb_email_label'|trans([], 'contao_default'), values, errors, 'email', true, 'autocomplete="email"') }}
                        {{ gb.field('phone', 'MSC.gb_phone'|trans([], 'contao_default'), values, errors, 'tel', false, 'autocomplete="tel"') }}
                    </div>
                    {{ gb.field('message', 'MSC.gb_message'|trans([], 'contao_default'), values, errors, 'textarea') }}
                    <div class="gb-hp" aria-hidden="true"><label for="gb-website">Website</label><input type="text" name="website" id="gb-website" tabindex="-1" autocomplete="off"></div>
                    <div class="widget widget-checkbox mandatory{{ errors.privacy|default ? ' error' }}">
                        {% if errors.privacy|default %}<p class="error">{{ errors.privacy }}</p>{% endif %}
                        <fieldset class="checkbox_container mandatory">
                            <span><input type="checkbox" name="privacy" id="gb-privacy" class="checkbox" value="1" required> <label for="gb-privacy">{{ privacy|insert_tag_raw|raw }}<span class="mandatory">*</span></label></span>
                        </fieldset>
                    </div>
                    {% if consent %}
                        <div class="widget widget-checkbox mandatory{{ errors.consent|default ? ' error' }}">
                            {% if errors.consent|default %}<p class="error">{{ errors.consent }}</p>{% endif %}
                            <fieldset class="checkbox_container mandatory">
                                <span><input type="checkbox" name="consent" id="gb-consent" class="checkbox" value="1" required> <label for="gb-consent">{{ consent|insert_tag_raw|raw }}<span class="mandatory">*</span></label></span>
                            </fieldset>
                        </div>
                        <p class="gb-hint gb-pay-hint">{{ 'MSC.gb_pay_hint'|trans([price, reserve_minutes], 'contao_default') }}</p>
                    {% endif %}
                    <div class="widget widget-submit">
                        <button type="submit" class="submit">{{ (price ? 'MSC.gb_book_pay' : 'MSC.gb_book')|trans([], 'contao_default') }}</button>
                    </div>
                </form>
            {% elseif not picker.empty and picker.day %}
                <p class="gb-hint">{{ 'MSC.gb_pick_time'|trans([], 'contao_default') }}</p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
