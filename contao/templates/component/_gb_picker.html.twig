{# Terminauswahl: Monat mit buchbaren Tagen, darunter die Uhrzeiten des gewählten Tags. Nur Links, kein JavaScript nötig. #}
{% macro picker(picker) %}
    {% if picker.empty %}
        <p class="gb-empty">{{ 'MSC.gb_no_slots'|trans([], 'contao_default') }}</p>
    {% else %}
        <div class="gb-picker">
            <div class="gb-month">
                <div class="gb-month__head">
                    {% if picker.prev_url %}<a class="gb-month__nav" href="{{ picker.prev_url }}" rel="nofollow" aria-label="{{ 'MSC.gb_prev_month'|trans([], 'contao_default') }}">‹</a>{% else %}<span class="gb-month__nav" aria-hidden="true"></span>{% endif %}
                    <h3 class="gb-month__title">{{ picker.month_label }}</h3>
                    {% if picker.next_url %}<a class="gb-month__nav" href="{{ picker.next_url }}" rel="nofollow" aria-label="{{ 'MSC.gb_next_month'|trans([], 'contao_default') }}">›</a>{% else %}<span class="gb-month__nav" aria-hidden="true"></span>{% endif %}
                </div>
                <table class="gb-month__grid">
                    <thead><tr>{% for name in picker.weekdays %}<th scope="col">{{ name }}</th>{% endfor %}</tr></thead>
                    <tbody>
                        {% for week in picker.weeks %}
                            <tr>
                                {% for day in week %}
                                    <td>
                                        {% if day.available %}
                                            <a class="gb-day gb-day--free{{ day.selected ? ' is-selected' }}" href="{{ day.url }}" rel="nofollow"{% if day.selected %} aria-current="date"{% endif %}>{{ day.day }}</a>
                                        {% elseif day.in_month %}
                                            <span class="gb-day">{{ day.day }}</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="gb-times">
                {% if picker.day %}
                    <h3 class="gb-times__title">{{ picker.day_label }}</h3>
                    <ul class="gb-times__list" role="list">
                        {% for time in picker.times %}
                            <li><a class="gb-time{{ time.selected ? ' is-selected' }}" href="{{ time.url }}" rel="nofollow"{% if time.selected %} aria-current="true"{% endif %}>{{ time.label }}</a></li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="gb-empty">{{ 'MSC.gb_no_slots_month'|trans([], 'contao_default') }}</p>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endmacro %}

{% macro field(name, label, values, errors, type = 'text', mandatory = false, attrs = '') %}
    <div class="widget widget-{{ type == 'textarea' ? 'textarea' : 'text' }}{{ mandatory ? ' mandatory' }}{{ errors[name]|default ? ' error' }}">
        <label for="gb-{{ name }}"{% if mandatory %} class="mandatory"{% endif %}>{% if mandatory %}<span class="invisible">{{ 'MSC.mandatory'|trans([], 'contao_default') }} </span>{% endif %}{{ label }}{% if mandatory %}<span class="mandatory">*</span>{% endif %}</label>
        {% if errors[name]|default %}<p class="error">{{ errors[name] }}</p>{% endif %}
        {% if type == 'textarea' %}
            <textarea name="{{ name }}" id="gb-{{ name }}" class="textarea" rows="4" cols="40">{{ values[name] }}</textarea>
        {% else %}
            <input type="{{ type }}" name="{{ name }}" id="gb-{{ name }}" class="text" value="{{ values[name] }}"{{ mandatory ? ' required' }} {{ attrs|raw }}>
        {% endif %}
    </div>
{% endmacro %}
